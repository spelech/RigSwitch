<Window x:Class="RigSwitch.App.Views.MainSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RigSwitch.App.ViewModels"
        xmlns:ctrl="clr-namespace:RigSwitch.App.Controls"
        mc:Ignorable="d"
        Title="RigSwitch — Workstation &amp; Sim Rig Hardware Controller"
        Width="780"
        Height="620"
        MinWidth="700"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        d:DataContext="{d:DesignInstance Type=vm:MainSettingsViewModel}">

    <Window.Resources>
        <!-- Pure Pitch-Black OLED & High-Contrast Telemetry Palette -->
        <SolidColorBrush x:Key="OledBaseBg" Color="#000000" />
        <SolidColorBrush x:Key="OledControlBg" Color="#08080C" />
        <SolidColorBrush x:Key="OledBorder" Color="#262634" />
        <SolidColorBrush x:Key="OledBorderBright" Color="#3A3A4E" />
        
        <!-- Deep Luminous Emerald Green & Molten Racing Orange -->
        <SolidColorBrush x:Key="AccentGreen" Color="#00C853" />
        <SolidColorBrush x:Key="AccentOrange" Color="#FF5500" />
        <SolidColorBrush x:Key="AccentRig" Color="#FF5500" />
        <SolidColorBrush x:Key="AccentDesk" Color="#00C853" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextMuted" Color="#8E95A5" />

        <!-- Base Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- High-Contrast Pure Pitch-Black TextBox Style with explicit ControlTemplate -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A0F" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource OledBorderBright}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentGreen}" />
            <Setter Property="SelectionBrush" Value="#00C853" />
            <Setter Property="SelectionOpacity" Value="0.4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#555577" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentGreen}" />
                                <Setter TargetName="border" Property="Background" Value="#000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox ToggleButton Style -->
        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="templateRoot"
                                Background="#0A0A0F"
                                BorderBrush="{StaticResource OledBorderBright}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Border x:Name="splitBorder"
                                    Width="24"
                                    HorizontalAlignment="Right"
                                    Margin="0"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="arrow"
                                      Data="F1 M 0,0 L 2.667,2.667 L 5.333,0 Z"
                                      Fill="#8E95A5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#555577" />
                                <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{StaticResource AccentGreen}" />
                                <Setter TargetName="arrow" Property="Fill" Value="{StaticResource AccentGreen}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="templateRoot" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Contrast ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0A0A0F" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A28" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D2818" />
                                <Setter Property="Foreground" Value="#00E676" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Contrast ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0A0A0F" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource OledBorderBright}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="toggleButton"
                                          Style="{StaticResource ComboBoxToggleButtonStyle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        Background="#0A0A0F"
                                        BorderBrush="{StaticResource OledBorderBright}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="dropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="templateRoot" Property="Opacity" Value="0.56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#101016" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource OledBorderBright}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="AccentSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF5500" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
        </Style>

        <!-- Modern Motorsport Tab Styling -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource OledBaseBg}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#000000"
                                BorderBrush="{StaticResource OledBorder}"
                                BorderThickness="0,0,1,2"
                                Padding="18,12"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0A0A10" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,1,2" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentGreen}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Header & Detail Templates -->
        <DataTemplate x:Key="PresetHeaderTemplate" DataType="{x:Type vm:PresetConfigurationItemViewModel}">
            <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="SemiBold" />
        </DataTemplate>

        <DataTemplate x:Key="PresetDetailTemplate" DataType="{x:Type vm:PresetConfigurationItemViewModel}">
            <StackPanel Margin="0,14,0,4">
                <RadioButton Content="Active / Default Preset"
                             IsChecked="{Binding IsActive, Mode=TwoWay}"
                             GroupName="{Binding GroupName}"
                             FontWeight="Bold"
                             Foreground="{StaticResource AccentGreen}"
                             Margin="0,0,0,14" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Preset Name:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Target Display:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.AvailableDisplayOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding TargetMonitorId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Content="🖥️ Windows Display Settings"
                            Command="{Binding OpenDisplaySettingsCommand}"
                            Padding="10,5"
                            FontSize="12" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Primary Audio Endpoint:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.AvailableAudioOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding PrimaryAudioId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Fallback Audio Endpoint:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.AvailableAudioOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding FallbackAudioId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Direct Hotkey:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                    <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding DirectHotkey, Mode=TwoWay}" Watermark="None (Optional)" />
                </Grid>

                <!-- Applications & Tools Lifecycle Hooks -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Auto-Launch Hooks:" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{StaticResource TextMuted}" />
                    <StackPanel Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding ApplicationHooks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ApplicationHookItemViewModel}">
                                    <Border Background="#050508" BorderBrush="{StaticResource OledBorderBright}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Content="Close on switch away" IsChecked="{Binding CloseOnSwitchAway, Mode=TwoWay}" VerticalAlignment="Center" Margin="14,0,10,0" FontSize="11" />
                                            <Button Grid.Column="2" Content="✕" Command="{Binding RemoveCommand}" Padding="8,3" FontSize="11" VerticalAlignment="Center" ToolTip="Remove application hook" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Add Application (.exe)" Command="{Binding AddApplicationHookCommand}" HorizontalAlignment="Left" Padding="12,6" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cockpit Header Bar -->
        <Border Grid.Row="0" Background="#000000" BorderBrush="{StaticResource OledBorder}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ RIGSWITCH" FontSize="18" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display, Bahnschrift" Margin="0,0,14,0" Foreground="#FFFFFF" />
                    <Border Background="#000000" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1.5" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentProfileBadgeText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🖥️ Desk Setup" Command="{Binding SwitchToDeskCommand}" Margin="0,0,10,0" BorderBrush="{StaticResource AccentGreen}" />
                    <Button Content="🏎️ Sim Rig" Command="{Binding SwitchToRigCommand}" BorderBrush="{StaticResource AccentOrange}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Content -->
        <TabControl Grid.Row="1" Background="{StaticResource OledBaseBg}">
            <!-- Tab 1: Workstation Profiles -->
            <TabItem Header="⚙️ Workstation Profiles">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                    <StackPanel>
                        <!-- Desk Presets Card: Pure Black with 3px Deep Emerald Left Accent Stripe -->
                        <Border Background="#000000" BorderBrush="{StaticResource AccentGreen}" BorderThickness="3,1,1,1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="🖥️ DESK PRESETS" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Bahnschrift" Foreground="{StaticResource AccentGreen}" />
                                    <TextBlock Text=" — Productivity &amp; Media" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" />
                                </StackPanel>
                                <TabControl ItemsSource="{Binding DeskPresets}"
                                            ItemTemplate="{StaticResource PresetHeaderTemplate}"
                                            ContentTemplate="{StaticResource PresetDetailTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- Sim Rig Presets Card: Pure Black with 3px Racing Orange Left Accent Stripe -->
                        <Border Background="#000000" BorderBrush="{StaticResource AccentOrange}" BorderThickness="3,1,1,1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="🏎️ SIM RIG PRESETS" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Bahnschrift" Foreground="{StaticResource AccentOrange}" />
                                    <TextBlock Text=" — GT3, Rally &amp; Flight Cockpit" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" />
                                </StackPanel>
                                <TabControl ItemsSource="{Binding RigPresets}"
                                            ItemTemplate="{StaticResource PresetHeaderTemplate}"
                                            ContentTemplate="{StaticResource PresetDetailTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- Hardware Telemetry Summary: Pure Black with 3px Titanium Left Accent Stripe -->
                        <Border Background="#000000" BorderBrush="{StaticResource OledBorderBright}" BorderThickness="3,1,1,1" CornerRadius="6" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="HARDWARE TELEMETRY" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Bahnschrift" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="↻ Refresh Hardware" Command="{Binding RefreshDevicesCommand}" Padding="10,4" FontSize="12" />
                                </Grid>
                                <TextBlock Text="Active Displays:" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{StaticResource TextMuted}" />
                                <ItemsControl ItemsSource="{Binding DetectedDisplays}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FriendlyName, StringFormat='• {0}'}" Margin="8,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Active Audio Endpoints:" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource TextMuted}" />
                                <ItemsControl ItemsSource="{Binding DetectedAudioEndpoints}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name, StringFormat='• {0}'}" Margin="8,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Device Nicknames -->
            <TabItem Header="🏷️ Device Nicknames">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Map detected monitors and audio playback devices to clean friendly names. These nicknames override cryptic Windows hardware identifiers."
                               Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DeviceNicknames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#000000"
                                            BorderBrush="{StaticResource OledBorderBright}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="14"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#08080C" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DeviceType}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding HardwareName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DeviceId}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding CustomNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center"
                                                     ToolTip="Enter custom friendly nickname" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Tab 3: Audio Device Visibility -->
            <TabItem Header="🎧 Audio Cleanup">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Clean up Windows audio menus by toggling virtual playback endpoints. Unchecked devices (e.g. SteelSeries Sonar virtual channels, Oculus Virtual Audio, Steam Streaming) are disabled in real-time."
                               Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />

                    <!-- Search and Filter Controls -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Box with Clean Watermark -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <TextBox x:Name="AudioSearchTextBox"
                                     Text="{Binding AudioSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,6"
                                     ToolTip="Search audio devices by name or adapter" />
                            <TextBlock Text="🔍 Search audio endpoints..."
                                       Foreground="#55556E"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AudioSearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Status Filter Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="All Devices"
                                    Command="{Binding SelectAllAudioFilterCommand}"
                                    Padding="12,5"
                                    Margin="0,0,6,0"
                                    FontSize="12" />
                            <Button Content="Active Only"
                                    Command="{Binding SelectActiveAudioFilterCommand}"
                                    Padding="12,5"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    BorderBrush="{StaticResource AccentGreen}" />
                            <Button Content="Disabled / Unplugged"
                                    Command="{Binding SelectInactiveAudioFilterCommand}"
                                    Padding="12,5"
                                    FontSize="12"
                                    BorderBrush="{StaticResource AccentOrange}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredAudioEndpoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#050508"
                                            BorderBrush="{StaticResource OledBorderBright}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="14"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,14,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="{Binding Adapter}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#55556E" Margin="0,1,0,0" />
                                            </StackPanel>
                                            
                                            <!-- Presence State Badge -->
                                            <Border Grid.Column="2"
                                                    Background="{Binding StateBadgeBackground}"
                                                    BorderBrush="{Binding StateBadgeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateLabel}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding StateBadgeForeground}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Tab 4: Hotkeys & System -->
            <TabItem Header="⌨️ Global Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <!-- Global Hotkeys Card: Pure Black with 3px Racing Orange Left Accent Stripe -->
                        <Border Background="#000000" BorderBrush="{StaticResource AccentOrange}" BorderThickness="3,1,1,1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="GLOBAL HOTKEYS" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Bahnschrift" Foreground="{StaticResource AccentOrange}" Margin="0,0,0,14" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Toggle Desk / Sim Rig:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding ToggleHotkey, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Direct Desk Activation:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding DeskHotkey, Mode=TwoWay}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Direct Sim Rig Activation:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding RigHotkey, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Preferences Card: Pure Black with 3px Titanium Left Accent Stripe -->
                        <Border Background="#000000" BorderBrush="{StaticResource OledBorderBright}" BorderThickness="3,1,1,1" CornerRadius="6" Padding="18">
                            <StackPanel>
                                <TextBlock Text="APPLICATION PREFERENCES" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Bahnschrift" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14" />
                                <CheckBox Content="Start RigSwitch minimized to Windows system tray"
                                          IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}"
                                          Margin="0,0,0,12" />
                                <CheckBox Content="Display balloon notifications when workstation profile switches"
                                          IsChecked="{Binding ShowToastNotifications, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar & Status -->
        <Border Grid.Row="2" Background="#000000" BorderBrush="{StaticResource OledBorder}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="💾 Save Settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource AccentSaveButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
