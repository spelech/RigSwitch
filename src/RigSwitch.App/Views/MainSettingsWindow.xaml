<Window x:Class="RigSwitch.App.Views.MainSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RigSwitch.App.ViewModels"
        xmlns:ctrl="clr-namespace:RigSwitch.App.Controls"
        xmlns:enums="clr-namespace:RigSwitch.Core.Enums;assembly=RigSwitch.Core"
        mc:Ignorable="d"
        Title="RigSwitch — Workstation &amp; Sim Rig Hardware Controller"
        Width="880"
        Height="680"
        MinWidth="800"
        MinHeight="580"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MutedCharcoalBg}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        d:DataContext="{d:DesignInstance Type=vm:MainSettingsViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Palette Aliases for Warm Charcoal Theme -->
        <SolidColorBrush x:Key="OledBaseBg" Color="#1C1D1F" />
        <SolidColorBrush x:Key="OledControlBg" Color="#26272B" />
        <SolidColorBrush x:Key="OledBorder" Color="#2A2B2F" />
        <SolidColorBrush x:Key="OledBorderBright" Color="#33353D" />

        <SolidColorBrush x:Key="TextPrimary" Color="#E2E4E8" />
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B" />

        <!-- Base Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource FluentTextBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}" />

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource FluentButton}" />

        <Style x:Key="AccentSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentActionButton}">
            <Setter Property="Background" Value="{StaticResource AccentDesk}" />
            <Setter Property="Foreground" Value="#141517" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="22,8" />
        </Style>

        <!-- Monitor Tile Template for Drag-and-Drop / Pile Management -->
        <DataTemplate x:Key="MonitorTileTemplate" DataType="{x:Type vm:DisplayMonitorTileViewModel}">
            <Border x:Name="TileBorder"
                    Background="{StaticResource GraphiteCardBg}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,10,10"
                    Width="160">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Tile Header Badge -->
                    <Border x:Name="HeaderBadge"
                            Grid.Row="0"
                            Background="#182A22"
                            BorderBrush="{StaticResource AccentDesk}"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8">
                        <TextBlock x:Name="HeaderText"
                                   Text="{Binding DisplayNumber, StringFormat='Monitor {0}'}"
                                   FontWeight="ExtraBold"
                                   FontSize="15"
                                   Foreground="{StaticResource AccentDesk}" />
                    </Border>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="{Binding FriendlyName}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="140" />
                        <TextBlock Text="{Binding MonitorId}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="140" />
                        <TextBlock x:Name="OfflineStatusText"
                                   Text="Offline / Disconnected"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#F87171"
                                   TextAlignment="Center"
                                   Visibility="Collapsed"
                                   Margin="0,2,0,0" />
                        <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,3,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding HasHdrBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding HdrBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                    </StackPanel>

                    <!-- Pile Action Buttons -->
                    <UniformGrid Grid.Row="2" Columns="3">
                        <Button Content="Off"
                                Command="{Binding MoveToUnassignedCommand}"
                                Padding="4,2"
                                FontSize="10"
                                Margin="1"
                                ToolTip="Remove from Desk/Rig profiles" />
                        <Button Content="Desk"
                                Command="{Binding MoveToDeskCommand}"
                                Padding="4,2"
                                FontSize="10"
                                Margin="1"
                                BorderBrush="{StaticResource AccentDesk}"
                                ToolTip="Assign to Desk Profile" />
                        <Button Content="Rig"
                                Command="{Binding MoveToRigCommand}"
                                Padding="4,2"
                                FontSize="10"
                                Margin="1"
                                BorderBrush="{StaticResource AccentRig}"
                                ToolTip="Assign to Sim Rig Profile" />
                    </UniformGrid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="TileBorder" Property="Opacity" Value="0.65" />
                    <Setter TargetName="HeaderBadge" Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                    <Setter TargetName="HeaderText" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                    <Setter TargetName="OfflineStatusText" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Inner Presets Sub-Tab Styling -->
        <Style x:Key="SubTabItemStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="16,8"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentDesk}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SubTabItemStyle}" />
        </Style>

        <!-- Preset Header & Detail Templates -->
        <DataTemplate x:Key="PresetHeaderTemplate" DataType="{x:Type vm:PresetConfigurationItemViewModel}">
            <TextBlock Text="{Binding Header}" FontSize="12.5" FontWeight="SemiBold" />
        </DataTemplate>

        <DataTemplate x:Key="PresetDetailTemplate" DataType="{x:Type vm:PresetConfigurationItemViewModel}">
            <StackPanel Margin="0,14,0,4">
                <RadioButton Content="Active / Default Preset"
                             IsChecked="{Binding IsActive, Mode=TwoWay}"
                             GroupName="{Binding GroupName}"
                             FontWeight="Bold"
                             Foreground="{StaticResource AccentDesk}"
                             Margin="0,0,0,14" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Preset Name:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Target Display:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.AvailableDisplayOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding TargetMonitorId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Content="🖥️ Windows Display Settings"
                            Command="{Binding OpenDisplaySettingsCommand}"
                            Padding="10,5"
                            FontSize="12" />
                </Grid>

                <!-- Native Windows HDR (Advanced Color) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Windows HDR (Color):" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox Grid.Column="1"
                              SelectedValue="{Binding HdrMode, Mode=TwoWay}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Retain Current Windows HDR State" Tag="{x:Static enums:PresetHdrMode.Retain}" />
                        <ComboBoxItem Content="Enable HDR (Advanced Color)" Tag="{x:Static enums:PresetHdrMode.Enable}" />
                        <ComboBoxItem Content="Disable HDR (SDR Standard)" Tag="{x:Static enums:PresetHdrMode.Disable}" />
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Primary Audio Endpoint:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.AvailableAudioOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding PrimaryAudioId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Secondary Audio (Headset / Sonar):" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.AvailableAudioOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding SecondaryAudioId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Fallback Audio Endpoint:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.AvailableAudioOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding FallbackAudioId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName" />
                </Grid>

                <!-- Playback Volume Settings -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Playback Volume:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox SelectedValue="{Binding PlaybackVolumeMode, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Margin="0,0,0,6">
                            <ComboBoxItem Content="Retain System Volume" Tag="{x:Static enums:PresetVolumeBehavior.Retain}" />
                            <ComboBoxItem Content="Custom Volume Level" Tag="{x:Static enums:PresetVolumeBehavior.Custom}" />
                        </ComboBox>
                        <Grid Grid.Row="1" Visibility="{Binding IsCustomPlaybackVolume, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Value="{Binding PlaybackVolumePercent, Mode=TwoWay}"
                                    Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding PlaybackVolumePercent, StringFormat='{}{0}%'}"
                                       VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <CheckBox Grid.Column="2" Content="Mute"
                                      IsChecked="{Binding PlaybackVolumeIsMuted, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Microphone Routing -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Primary Microphone:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.AvailableMicrophoneOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding PrimaryMicrophoneId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Secondary Microphone:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.AvailableMicrophoneOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding SecondaryMicrophoneId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Fallback Microphone:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.AvailableMicrophoneOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding FallbackMicrophoneId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="DisplayName" />
                </Grid>

                <!-- Microphone Volume Settings -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Microphone Volume:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox SelectedValue="{Binding MicrophoneVolumeMode, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Margin="0,0,0,6">
                            <ComboBoxItem Content="Retain System Volume" Tag="{x:Static enums:PresetVolumeBehavior.Retain}" />
                            <ComboBoxItem Content="Custom Input Level" Tag="{x:Static enums:PresetVolumeBehavior.Custom}" />
                        </ComboBox>
                        <Grid Grid.Row="1" Visibility="{Binding IsCustomMicrophoneVolume, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Value="{Binding MicrophoneVolumePercent, Mode=TwoWay}"
                                    Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding MicrophoneVolumePercent, StringFormat='{}{0}%'}"
                                       VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <CheckBox Grid.Column="2" Content="Mute"
                                      IsChecked="{Binding MicrophoneVolumeIsMuted, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Direct Hotkey:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding DirectHotkey, Mode=TwoWay}" Watermark="None (Optional)" />
                </Grid>

                <!-- Applications & Tools Lifecycle Hooks -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Auto-Launch Hooks:" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" />
                    <StackPanel Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding ApplicationHooks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ApplicationHookItemViewModel}">
                                    <Border Background="{StaticResource GraphiteCardBg}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Content="Close on switch away" IsChecked="{Binding CloseOnSwitchAway, Mode=TwoWay}" VerticalAlignment="Center" Margin="14,0,10,0" FontSize="11" />
                                            <Button Grid.Column="2" Content="✕" Command="{Binding RemoveCommand}" Padding="8,3" FontSize="11" VerticalAlignment="Center" ToolTip="Remove application hook" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Add Application (.exe)" Command="{Binding AddApplicationHookCommand}" HorizontalAlignment="Left" Padding="12,6" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderFooterBg}"
                BorderBrush="{StaticResource HeaderFooterBorder}"
                BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ RigSwitch"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center" />
                    <!-- Profile Badge Pill: Soft Sage border/text when Desk, Warm Amber Gold when Rig -->
                    <Border CornerRadius="12"
                            BorderThickness="1.5"
                            Padding="12,4"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#182A22" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentDesk}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRigActive}" Value="True">
                                        <Setter Property="Background" Value="#2D2316" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentRig}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CurrentProfileBadgeText}"
                                   FontSize="13"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AccentDesk}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRigActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentRig}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Quick Station Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🖥️ Desk Setup"
                            Command="{Binding SwitchToDeskCommand}"
                            Style="{StaticResource FluentButton}"
                            BorderBrush="{StaticResource AccentDesk}"
                            Margin="0,0,10,0"
                            Padding="14,7"
                            FontSize="13" />
                    <Button Content="🏎️ Sim Rig"
                            Command="{Binding SwitchToRigCommand}"
                            Style="{StaticResource FluentButton}"
                            BorderBrush="{StaticResource AccentRig}"
                            Padding="14,7"
                            FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Navigation Body: 2-Column Sidebar Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Navigation Sidebar Rail -->
            <Border Grid.Column="0"
                    Background="{StaticResource SlateSidebarBg}"
                    BorderBrush="{StaticResource HeaderFooterBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="14,16,14,14">
                <DockPanel LastChildFill="True">
                    <!-- Bottom: CoreAudio Watchdog Status Card -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource GraphiteCardBg}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentDesk}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="CoreAudio Watchdog" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Real-time session monitoring active" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Top: Navigation Rail Items -->
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavPresets"
                                     Content="🖥️ Presets"
                                     Style="{StaticResource FluentNavButton}"
                                     GroupName="SidebarNav"
                                     Tag="0"
                                     IsChecked="True"
                                     Checked="NavButton_Checked" />
                        <RadioButton x:Name="NavDisplays"
                                     Content="📺 Displays &amp; Topology"
                                     Style="{StaticResource FluentNavButton}"
                                     GroupName="SidebarNav"
                                     Tag="1"
                                     Checked="NavButton_Checked" />
                        <RadioButton x:Name="NavAudio"
                                     Content="🔊 Audio &amp; DAC Lockout"
                                     Style="{StaticResource FluentNavButton}"
                                     GroupName="SidebarNav"
                                     Tag="2"
                                     Checked="NavButton_Checked" />
                        <RadioButton x:Name="NavNicknames"
                                     Content="🏷️ Device Nicknames"
                                     Style="{StaticResource FluentNavButton}"
                                     GroupName="SidebarNav"
                                     Tag="3"
                                     Checked="NavButton_Checked" />
                        <RadioButton x:Name="NavHotkeys"
                                     Content="⌨️ Hotkeys &amp; System"
                                     Style="{StaticResource FluentNavButton}"
                                     GroupName="SidebarNav"
                                     Tag="4"
                                     Checked="NavButton_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Column 1: Main Content Pane -->
            <TabControl x:Name="ContentTabControl"
                        Grid.Column="1"
                        Background="{StaticResource MutedCharcoalBg}"
                        BorderThickness="0"
                        Padding="0"
                        SelectionChanged="ContentTabControl_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavPresets}" Value="True">
                                <Setter Property="SelectedIndex" Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavDisplays}" Value="True">
                                <Setter Property="SelectedIndex" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavAudio}" Value="True">
                                <Setter Property="SelectedIndex" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavNicknames}" Value="True">
                                <Setter Property="SelectedIndex" Value="3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavHotkeys}" Value="True">
                                <Setter Property="SelectedIndex" Value="4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>

                <!-- Page 0: Presets -->
                <TabItem Header="🖥️ Presets">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                        <StackPanel>
                            <!-- Desk Presets Card -->
                            <Border Background="{StaticResource GraphiteCardBg}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="🖥️ DESK PRESETS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentDesk}" />
                                        <TextBlock Text=" — Productivity &amp; Media" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TabControl ItemsSource="{Binding DeskPresets}"
                                                Style="{StaticResource SubTabControlStyle}"
                                                ItemTemplate="{StaticResource PresetHeaderTemplate}"
                                                ContentTemplate="{StaticResource PresetDetailTemplate}" />
                                </StackPanel>
                            </Border>

                            <!-- Sim Rig Presets Card -->
                            <Border Background="{StaticResource GraphiteCardBg}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="🏎️ SIM RIG PRESETS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentRig}" />
                                        <TextBlock Text=" — GT3, Rally &amp; Flight Cockpit" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TabControl ItemsSource="{Binding RigPresets}"
                                                Style="{StaticResource SubTabControlStyle}"
                                                ItemTemplate="{StaticResource PresetHeaderTemplate}"
                                                ContentTemplate="{StaticResource PresetDetailTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Page 1: Displays & Topology -->
                <TabItem Header="📺 Displays &amp; Topology">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                        <StackPanel>
                            <!-- Multi-Monitor Topology Card -->
                            <Border Background="{StaticResource GraphiteCardBg}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="🖥️ MULTI-MONITOR TOPOLOGY CONFIGURATION" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Assign connected monitors by number to Desk or Sim Rig piles (supports single, dual, or 3-screen sim rigs)." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="🔍 Identify Monitors"
                                                Command="{Binding IdentifyMonitorsCommand}"
                                                Padding="12,6"
                                                Style="{StaticResource FluentButton}"
                                                BorderBrush="{StaticResource AccentDesk}"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding MonitorTiles}"
                                                  ItemTemplate="{StaticResource MonitorTileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Hardware Telemetry Summary Card -->
                            <Border Background="{StaticResource GraphiteCardBg}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="HARDWARE TELEMETRY" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="↻ Refresh Hardware" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource FluentButton}" Padding="10,4" FontSize="12" />
                                    </Grid>
                                    <TextBlock Text="Active Displays:" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{StaticResource TextMutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding DetectedDisplays}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FriendlyName, StringFormat='• {0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Active Audio Endpoints:" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource TextMutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding DetectedAudioEndpoints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, StringFormat='• {0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Page 2: Audio & DAC Lockout -->
                <TabItem Header="🔊 Audio &amp; DAC Lockout">
                    <Grid Margin="24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Clean up Windows audio menus by toggling virtual playback endpoints. Unchecked devices (e.g. SteelSeries Sonar virtual channels, Oculus Virtual Audio, Steam Streaming) are disabled in real-time."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <!-- Search and Filter Controls -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Box with Clean Watermark -->
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <TextBox x:Name="AudioSearchTextBox"
                                         Text="{Binding AudioSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FluentTextBox}"
                                         Padding="10,6"
                                         ToolTip="Search audio devices by name or adapter" />
                                <TextBlock Text="🔍 Search audio endpoints..."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=AudioSearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Status Filter Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="All Devices"
                                        Command="{Binding SelectAllAudioFilterCommand}"
                                        Style="{StaticResource FluentButton}"
                                        Padding="12,5"
                                        Margin="0,0,6,0"
                                        FontSize="12" />
                                <Button Content="Active Only"
                                        Command="{Binding SelectActiveAudioFilterCommand}"
                                        Style="{StaticResource FluentButton}"
                                        Padding="12,5"
                                        Margin="0,0,6,0"
                                        FontSize="12"
                                        BorderBrush="{StaticResource AccentDesk}" />
                                <Button Content="Disabled / Unplugged"
                                        Command="{Binding SelectInactiveAudioFilterCommand}"
                                        Style="{StaticResource FluentButton}"
                                        Padding="12,5"
                                        FontSize="12"
                                        BorderBrush="{StaticResource AccentRig}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredAudioEndpoints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource GraphiteCardBg}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="14"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,14,0"
                                                          ToolTip="Toggle endpoint visibility in Windows audio menus" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Adapter}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Opacity="0.7" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Blacklist / Bass Shaker Exclusion Toggle -->
                                                <CheckBox Grid.Column="2"
                                                          Content="Exclude / Bass Shaker DAC"
                                                          IsChecked="{Binding IsBlacklisted, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          FontSize="12"
                                                          Margin="0,0,16,0"
                                                          ToolTip="Exclude this audio endpoint from profile routing (e.g. Bass Shaker / Buttkicker DAC)." />

                                                <!-- Presence State Badge -->
                                                <Border Grid.Column="3"
                                                        Background="{Binding StateBadgeBackground}"
                                                        BorderBrush="{Binding StateBadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateLabel}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding StateBadgeForeground}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Page 3: Device Nicknames -->
                <TabItem Header="🏷️ Device Nicknames">
                    <Grid Margin="24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Map detected monitors and audio playback devices to clean friendly names. These nicknames override cryptic Windows hardware identifiers."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DeviceNicknames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource GraphiteCardBg}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="14"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="280" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#1C1D1F" BorderBrush="{StaticResource AccentDesk}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding DeviceType}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentDesk}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding HardwareName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DeviceId}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding CustomNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource FluentTextBox}"
                                                         VerticalAlignment="Center"
                                                         ToolTip="Enter custom friendly nickname" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Page 4: Hotkeys & System -->
                <TabItem Header="⌨️ Hotkeys &amp; System">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                        <StackPanel>
                            <!-- Global Hotkeys Card -->
                            <Border Background="{StaticResource GraphiteCardBg}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="GLOBAL HOTKEYS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentRig}" Margin="0,0,0,14" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Toggle Desk / Sim Rig:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding ToggleHotkey, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Direct Desk Activation:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding DeskHotkey, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Direct Sim Rig Activation:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding RigHotkey, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Toggle Audio (Speakers / Headset):" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding AudioToggleHotkey, Mode=TwoWay}" Watermark="None (Optional)" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Preferences Card -->
                            <Border Background="{StaticResource GraphiteCardBg}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="APPLICATION PREFERENCES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />
                                    <CheckBox Content="Start RigSwitch minimized to Windows system tray"
                                              IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}"
                                              Margin="0,0,0,12" />
                                    <CheckBox Content="Display balloon notifications when workstation profile switches"
                                              IsChecked="{Binding ShowToastNotifications, Mode=TwoWay}"
                                              Margin="0,0,0,12" />
                                    <CheckBox Content="Actively enforce primary speakers against background hijacks (e.g. SteelSeries Sonar)"
                                              IsChecked="{Binding EnforcePrimaryAudio, Mode=TwoWay}"
                                              Margin="0,0,0,12" />
                                    <CheckBox Content="Automatically check for updates on startup"
                                              IsChecked="{Binding EnableAutoUpdateCheck, Mode=TwoWay}"
                                              Margin="0,0,0,16" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Software Updates" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Check GitHub Releases and WinGet for new RigSwitch versions" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🚀 Check for Updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource FluentButton}" Padding="12,6" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Bottom Status & Action Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource HeaderFooterBg}"
                BorderBrush="{StaticResource HeaderFooterBorder}"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="13.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Content="💾 Save Settings"
                        Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource FluentActionButton}"
                        Background="{StaticResource AccentDesk}"
                        Foreground="#141517"
                        FontWeight="Bold"
                        FontSize="13.5"
                        Padding="22,8" />
            </Grid>
        </Border>
    </Grid>
</Window>
