<Window x:Class="RigSwitch.App.Views.MainSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RigSwitch.App.ViewModels"
        xmlns:ctrl="clr-namespace:RigSwitch.App.Controls"
        xmlns:enums="clr-namespace:RigSwitch.Core.Enums;assembly=RigSwitch.Core"
        mc:Ignorable="d"
        Title="RigSwitch — Workstation &amp; Sim Rig Hardware Controller"
        Width="1240"
        Height="840"
        MinWidth="1040"
        MinHeight="680"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MutedCharcoalBg}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        d:DataContext="{d:DesignInstance Type=vm:MainSettingsViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Palette Aliases for Warm Charcoal Theme -->
        <SolidColorBrush x:Key="OledBaseBg" Color="#1C1D1F" />
        <SolidColorBrush x:Key="OledControlBg" Color="#26272B" />
        <SolidColorBrush x:Key="OledBorder" Color="#2A2B2F" />
        <SolidColorBrush x:Key="OledBorderBright" Color="#33353D" />

        <SolidColorBrush x:Key="TextPrimary" Color="#E2E4E8" />
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B" />

        <!-- Base Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource FluentTextBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource FluentToggleSwitch}" />
        <Style TargetType="Button" BasedOn="{StaticResource FluentButton}" />

        <Style x:Key="AccentSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentActionButton}">
            <Setter Property="Background" Value="{StaticResource AccentDesk}" />
            <Setter Property="Foreground" Value="#141517" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="22,8" />
        </Style>

        <!-- Sidebar Preset Item Template (Desk) -->
        <DataTemplate x:Key="DeskPresetNavItemTemplate" DataType="{x:Type vm:PresetConfigurationItemViewModel}">
            <Button Command="{Binding DataContext.NavigateToPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    Margin="0,2">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,7"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveBar"
                                        Grid.Column="0"
                                        Width="3.5"
                                        Height="22"
                                        CornerRadius="1.75"
                                        Background="{StaticResource AccentDesk}"
                                        Margin="0,0,9,0"
                                        Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText"
                                               Text="{Binding NavTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding NavSubLabel}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Ellipse x:Name="DefaultDot"
                                         Grid.Column="2"
                                         Width="7"
                                         Height="7"
                                         Fill="{StaticResource AccentDesk}"
                                         VerticalAlignment="Center"
                                         Margin="6,0,2,0"
                                         ToolTip="Default Active Desk Preset"
                                         Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#202227" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelectedInNav}" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#182A22" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#254437" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource AccentDesk}" />
                                <Setter TargetName="TitleText" Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="DefaultDot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Sidebar Preset Item Template (Sim Rig) -->
        <DataTemplate x:Key="RigPresetNavItemTemplate" DataType="{x:Type vm:PresetConfigurationItemViewModel}">
            <Button Command="{Binding DataContext.NavigateToPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    Margin="0,2">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,7"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveBar"
                                        Grid.Column="0"
                                        Width="3.5"
                                        Height="22"
                                        CornerRadius="1.75"
                                        Background="{StaticResource AccentRig}"
                                        Margin="0,0,9,0"
                                        Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText"
                                               Text="{Binding NavTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding NavSubLabel}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Ellipse x:Name="DefaultDot"
                                         Grid.Column="2"
                                         Width="7"
                                         Height="7"
                                         Fill="{StaticResource AccentRig}"
                                         VerticalAlignment="Center"
                                         Margin="6,0,2,0"
                                         ToolTip="Default Active Sim Rig Preset"
                                         Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#202227" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelectedInNav}" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#2D2316" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#4A3820" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource AccentRig}" />
                                <Setter TargetName="TitleText" Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="DefaultDot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Ranked Audio / Mic Priority Item Template -->
        <DataTemplate x:Key="RankedAudioItemTemplate" DataType="{x:Type vm:RankedAudioItemViewModel}">
            <Border Background="#1D1E22"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="9,5"
                    Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Rank Badge (#1, #2, #3) -->
                    <Border Grid.Column="0"
                            Background="#142921"
                            BorderBrush="{StaticResource AccentDesk}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="7,2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding RankBadgeText}"
                                   FontSize="11.5"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource AccentDesk}" />
                    </Border>

                    <!-- Device Name -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Live Status Pill -->
                    <Border Grid.Column="2"
                            Background="{Binding StatusBackground}"
                            CornerRadius="9"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{Binding StatusForeground}" />
                    </Border>

                    <!-- Up / Down / Remove Controls -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↑"
                                Command="{Binding MoveUpCommand}"
                                Padding="6,1.5"
                                FontSize="11"
                                Margin="0,0,3,0"
                                ToolTip="Move higher in priority" />
                        <Button Content="↓"
                                Command="{Binding MoveDownCommand}"
                                Padding="6,1.5"
                                FontSize="11"
                                Margin="0,0,3,0"
                                ToolTip="Move lower in priority" />
                        <Button Content="✕"
                                Command="{Binding RemoveCommand}"
                                Padding="6,1.5"
                                FontSize="11"
                                ToolTip="Remove from preset priority list" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Per-Preset Full Editor Template (2D Monitor Stage + Ranked Audio + Mic + App Hooks) -->
        <DataTemplate x:Key="PresetDetailTemplate" DataType="{x:Type vm:PresetConfigurationItemViewModel}">
            <StackPanel>
                <!-- Row 0: Compact Preset Identity, Default Active, Direct Hotkey & Activate Now Bar -->
                <Border Style="{StaticResource FluentSettingCard}" Padding="15,9" Margin="0,0,0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding NavTitle}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentDesk}" />
                            <TextBlock Text="Preset Label &amp; Shortcut" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,14,0"
                                 ToolTip="Friendly name for this preset" />

                        <RadioButton Grid.Column="2"
                                     Content="Default Active"
                                     IsChecked="{Binding IsActive, Mode=TwoWay}"
                                     GroupName="{Binding GroupName}"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,14,0" />

                        <Border Grid.Column="3" />

                        <TextBlock Grid.Column="4"
                                   Text="Hotkey:"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <ctrl:HotkeyRecorderControl Grid.Column="5"
                                                    Hotkey="{Binding DirectHotkey, Mode=TwoWay}"
                                                    Watermark="None (Optional)"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0" />

                        <Button Grid.Column="6"
                                Content="⚡ Activate Preset"
                                Command="{Binding ActivatePresetNowCommand}"
                                Style="{StaticResource FluentButton}"
                                BorderBrush="{StaticResource AccentDesk}"
                                Padding="12,6"
                                FontSize="12.5"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Row 1: 2-Column Main Hardware Grid (Left: 2D Monitor Topology Stage | Right: Ranked Playback Audio) -->
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.18*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: 2D Monitor Topology Stage + Slim Off-in-Preset Tray -->
                    <Border Grid.Column="0" Style="{StaticResource FluentSettingCard}" Padding="15,11" Margin="0">
                        <StackPanel>
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="🖥️ 2D Monitor Topology" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Monitors on stage are enabled. Drag to arrange or click ★ Primary / HDR." FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="🔍 Identify"
                                            Command="{Binding IdentifyMonitorsCommand}"
                                            Padding="9,5"
                                            FontSize="11.5"
                                            Margin="0,0,6,0"
                                            ToolTip="Show numbered overlay on physical displays" />
                                    <Button Content="📸 Capture Layout"
                                            Command="{Binding CaptureWindowsLayoutCommand}"
                                            Padding="9,5"
                                            FontSize="11.5"
                                            ToolTip="Read current Windows monitor positions into this preset" />
                                </StackPanel>
                            </Grid>

                            <!-- 2D Interactive Monitor Stage Canvas -->
                            <Border Background="#131417"
                                    BorderBrush="#2C2E36"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="164"
                                    ClipToBounds="True"
                                    Margin="0,0,0,7">
                                <Grid>
                                    <!-- Subtle Center Crosshair Axes -->
                                    <Line X1="0" Y1="82" X2="600" Y2="82" Stroke="#1F2229" StrokeThickness="1" StrokeDashArray="4,4" IsHitTestVisible="False" />
                                    <Line X1="260" Y1="0" X2="260" Y2="164" Stroke="#1F2229" StrokeThickness="1" StrokeDashArray="4,4" IsHitTestVisible="False" />

                                    <ItemsControl ItemsSource="{Binding StageMonitors}"
                                                  Width="520"
                                                  Height="164"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="520" Height="164" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                                <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PresetMonitorCanvasItemViewModel}">
                                                <Border Width="{Binding CanvasWidth}"
                                                        Height="{Binding CanvasHeight}"
                                                        Background="{Binding BackgroundHex}"
                                                        BorderBrush="{Binding BorderBrushHex}"
                                                        BorderThickness="2"
                                                        CornerRadius="6"
                                                        Padding="6,4"
                                                        Cursor="SizeAll"
                                                        MouseLeftButtonDown="StageMonitor_MouseLeftButtonDown"
                                                        MouseMove="StageMonitor_MouseMove"
                                                        MouseLeftButtonUp="StageMonitor_MouseLeftButtonUp"
                                                        ToolTip="Drag to reposition monitor in 2D space (snaps to adjacent edges)">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Top Row: Monitor Number + Friendly Name + Remove (✕) -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       FontSize="11.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="#FFFFFF"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center">
                                                                <Run Text="{Binding DisplayNumber, Mode=OneWay, StringFormat='#{0} '}" />
                                                                <Run Text="{Binding FriendlyName, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <Button Grid.Column="1"
                                                                    Content="✕"
                                                                    Command="{Binding RemoveFromStageCommand}"
                                                                    Padding="4,0"
                                                                    FontSize="10"
                                                                    Background="#281619"
                                                                    BorderBrush="#5E2831"
                                                                    Foreground="#FCA5A5"
                                                                    VerticalAlignment="Top"
                                                                    ToolTip="Disable monitor in this preset" />
                                                        </Grid>

                                                        <!-- Middle Row: Resolution & Coordinates -->
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding ResolutionAndPosText}"
                                                                   FontSize="10"
                                                                   Foreground="#9CA3AF"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <!-- Bottom Row: Primary (0,0) Toggle & HDR Mode Cycle Pill -->
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0"
                                                                    Content="{Binding PrimaryBadgeText}"
                                                                    Command="{Binding SetPrimaryCommand}"
                                                                    Padding="5,1.5"
                                                                    FontSize="9.5"
                                                                    ToolTip="Designate as Primary display anchored at (0,0)" />
                                                            <Button Grid.Column="2"
                                                                    Content="{Binding HdrBadgeText}"
                                                                    Command="{Binding CycleHdrCommand}"
                                                                    Background="{Binding HdrBadgeBackground}"
                                                                    Foreground="{Binding HdrBadgeForeground}"
                                                                    Padding="5,1.5"
                                                                    FontSize="9.5"
                                                                    ToolTip="Click to cycle Windows HDR mode (Retain / Enable / Disable)" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- Slim "Off in Preset" Tray -->
                            <Border Background="#191A1E"
                                    BorderBrush="#2A2C33"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,7">
                                <StackPanel>
                                    <TextBlock Text="OFF IN THIS PRESET (CLICK ＋ TO ENABLE ON STAGE)"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,0,5" />
                                    <ItemsControl ItemsSource="{Binding UnassignedMonitors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PresetMonitorCanvasItemViewModel}">
                                                <Border Background="#23252B"
                                                        BorderBrush="{StaticResource CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="8,4"
                                                        Margin="0,0,8,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayNumber, StringFormat='#{0}'}"
                                                                   FontWeight="Bold"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource AccentRig}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding FriendlyName}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   MaxWidth="135"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,6,0" />
                                                        <Button Content="＋ Enable"
                                                                Command="{Binding AddToStageCommand}"
                                                                Padding="6,2"
                                                                FontSize="10.5"
                                                                BorderBrush="{StaticResource AccentDesk}"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Enable and add monitor to 2D stage" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Ranked Playback Audio Priority List & Volume -->
                    <Border Grid.Column="2" Style="{StaticResource FluentSettingCard}" Padding="16,14" Margin="0">
                        <StackPanel>
                            <TextBlock Text="🔊 Playback Audio Priority Order" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Highest online device (#1 → #N) is activated automatically; Audio Toggle Hotkey cycles active devices in this list."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,10" />

                            <!-- Add Audio Device Row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AddableAudioOptions}"
                                          SelectedValue="{Binding SelectedAudioToAddId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="＋ Add Device"
                                        Command="{Binding AddAudioToRankingCommand}"
                                        BorderBrush="{StaticResource AccentDesk}"
                                        Padding="12,6"
                                        FontSize="12" />
                            </Grid>

                            <!-- Ranked Priority Items -->
                            <ItemsControl ItemsSource="{Binding AudioRanking}"
                                          ItemTemplate="{StaticResource RankedAudioItemTemplate}"
                                          MinHeight="110" />

                            <!-- Compact Playback Volume Bar -->
                            <Border BorderBrush="#2E3038" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,6,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Output Level:"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedValue="{Binding PlaybackVolumeMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Retain Current Windows Volume" Tag="{x:Static enums:PresetVolumeBehavior.Retain}" />
                                            <ComboBoxItem Content="Set Custom Volume Level" Tag="{x:Static enums:PresetVolumeBehavior.Custom}" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Visibility="{Binding IsCustomPlaybackVolume, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Value="{Binding PlaybackVolumePercent, Mode=TwoWay}"
                                                Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Border Grid.Column="1" Background="#1C1D1F" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PlaybackVolumePercent, StringFormat='{}{0}%'}"
                                                       FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="34" TextAlignment="Center" />
                                        </Border>
                                        <CheckBox Grid.Column="2"
                                                  Content="Mute"
                                                  Style="{StaticResource FluentToggleSwitch}"
                                                  IsChecked="{Binding PlaybackVolumeIsMuted, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2: Bottom 2-Column Grid (Left: Microphone Priority List | Right: Lifecycle Application Hooks) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Ranked Microphone Priority List & Input Gain -->
                    <Border Grid.Column="0" Style="{StaticResource FluentSettingCard}" Padding="16,13" Margin="0">
                        <StackPanel>
                            <TextBlock Text="🎙️ Microphone Priority Order" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Ordered voice input fallback list (#1 → #N) and microphone capture level."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AddableMicrophoneOptions}"
                                          SelectedValue="{Binding SelectedMicToAddId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="＋ Add Mic"
                                        Command="{Binding AddMicToRankingCommand}"
                                        BorderBrush="{StaticResource AccentDesk}"
                                        Padding="12,6"
                                        FontSize="12" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MicrophoneRanking}"
                                          ItemTemplate="{StaticResource RankedAudioItemTemplate}"
                                          MinHeight="48" />

                            <Border BorderBrush="#2E3038" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,6,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Mic Input Level:"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedValue="{Binding MicrophoneVolumeMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Retain Current Mic Gain" Tag="{x:Static enums:PresetVolumeBehavior.Retain}" />
                                            <ComboBoxItem Content="Set Custom Input Level" Tag="{x:Static enums:PresetVolumeBehavior.Custom}" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid Visibility="{Binding IsCustomMicrophoneVolume, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Value="{Binding MicrophoneVolumePercent, Mode=TwoWay}"
                                                Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Border Grid.Column="1" Background="#1C1D1F" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MicrophoneVolumePercent, StringFormat='{}{0}%'}"
                                                       FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="34" TextAlignment="Center" />
                                        </Border>
                                        <CheckBox Grid.Column="2"
                                                  Content="Mute"
                                                  Style="{StaticResource FluentToggleSwitch}"
                                                  IsChecked="{Binding MicrophoneVolumeIsMuted, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Lifecycle Application Hooks -->
                    <Border Grid.Column="2" Style="{StaticResource FluentSettingCard}" Padding="16,14" Margin="0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🚀 Lifecycle Application Hooks" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Launch apps when activating this preset, and optionally close them when switching away." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="＋ Add App (.exe)"
                                        Command="{Binding AddApplicationHookCommand}"
                                        Style="{StaticResource FluentButton}"
                                        Padding="10,6"
                                        FontSize="12"
                                        VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ApplicationHooks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ApplicationHookItemViewModel}">
                                        <Border Background="#1D1E22" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding ExecutablePath}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1"
                                                          Content="Close on switch"
                                                          Style="{StaticResource FluentToggleSwitch}"
                                                          IsChecked="{Binding CloseOnSwitchAway, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="8,0,10,0" />
                                                <Button Grid.Column="2"
                                                        Content="✕"
                                                        Command="{Binding RemoveCommand}"
                                                        Style="{StaticResource FluentButton}"
                                                        Padding="7,3"
                                                        FontSize="11"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Remove application hook" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource MutedCharcoalBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderFooterBg}"
                BorderBrush="{StaticResource HeaderFooterBorder}"
                BorderThickness="0,0,0,1"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ RigSwitch"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />

                    <!-- App Version Pill Badge -->
                    <Border Background="#1F2229"
                            BorderBrush="#363A45"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,2.5"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppVersionText}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Border>

                    <!-- Profile Badge Pill: Soft Sage border/text when Desk, Warm Amber Gold when Rig -->
                    <Border CornerRadius="12"
                            BorderThickness="1.5"
                            Padding="12,4"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#182A22" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentDesk}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRigActive}" Value="True">
                                        <Setter Property="Background" Value="#2D2316" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentRig}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CurrentProfileBadgeText}"
                                   FontSize="13"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AccentDesk}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRigActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentRig}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Quick Station Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻ Refresh Hardware"
                            Command="{Binding RefreshDevicesCommand}"
                            Style="{StaticResource FluentButton}"
                            Margin="0,0,10,0"
                            Padding="12,7"
                            FontSize="12.5" />
                    <Button Content="🖥️ Desk Setup"
                            Command="{Binding SwitchToDeskCommand}"
                            Style="{StaticResource FluentButton}"
                            BorderBrush="{StaticResource AccentDesk}"
                            Margin="0,0,10,0"
                            Padding="14,7"
                            FontSize="13" />
                    <Button Content="🏎️ Sim Rig"
                            Command="{Binding SwitchToRigCommand}"
                            Style="{StaticResource FluentButton}"
                            BorderBrush="{StaticResource AccentRig}"
                            Padding="14,7"
                            FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Navigation Body: 2-Column Sidebar Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Navigation Sidebar Rail -->
            <Border Grid.Column="0"
                    Background="{StaticResource SlateSidebarBg}"
                    BorderBrush="{StaticResource HeaderFooterBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="14,14,14,14">
                <DockPanel LastChildFill="True">
                    <!-- Bottom: CoreAudio Watchdog Status & Version Card -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource GraphiteCardBg}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11,10"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentDesk}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="CoreAudio Watchdog" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Event-driven routing active" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock FontSize="10.5" Foreground="#6B7280" Margin="0,4,0,0">
                                <Run Text="RigSwitch " />
                                <Run Text="{Binding AppVersionText, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=" • Win11 x64" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Direct Preset & System Navigation Rail -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Desk Presets Group -->
                            <TextBlock Text="🖥️ DESK PRESETS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentDesk}"
                                       Margin="6,2,0,4" />
                            <ItemsControl ItemsSource="{Binding DeskPresets}"
                                          ItemTemplate="{StaticResource DeskPresetNavItemTemplate}"
                                          Margin="0,0,0,12" />

                            <!-- Sim Rig Presets Group -->
                            <TextBlock Text="🏎️ SIM RIG PRESETS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentRig}"
                                       Margin="6,2,0,4" />
                            <ItemsControl ItemsSource="{Binding RigPresets}"
                                          ItemTemplate="{StaticResource RigPresetNavItemTemplate}"
                                          Margin="0,0,0,14" />

                            <!-- System & Hardware Group -->
                            <TextBlock Text="SYSTEM &amp; HARDWARE"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="6,2,0,4" />

                            <RadioButton x:Name="NavPresets"
                                         Visibility="Collapsed"
                                         GroupName="SidebarNav"
                                         Tag="0"
                                         Checked="NavButton_Checked" />
                            <RadioButton x:Name="NavDisplays"
                                         Visibility="Collapsed"
                                         GroupName="SidebarNav"
                                         Tag="1"
                                         Checked="NavButton_Checked" />

                            <RadioButton x:Name="NavAudio"
                                         Content="🔊 Audio &amp; DAC Lockout"
                                         Style="{StaticResource FluentNavButton}"
                                         GroupName="SidebarNav"
                                         Tag="2"
                                         IsChecked="{Binding IsAudioPageSelected, Mode=OneWay}"
                                         Checked="NavButton_Checked" />
                            <RadioButton x:Name="NavNicknames"
                                         Content="🏷️ Device Nicknames"
                                         Style="{StaticResource FluentNavButton}"
                                         GroupName="SidebarNav"
                                         Tag="3"
                                         IsChecked="{Binding IsNicknamesPageSelected, Mode=OneWay}"
                                         Checked="NavButton_Checked" />
                            <RadioButton x:Name="NavHotkeys"
                                         Content="⌨️ Hotkeys &amp; System"
                                         Style="{StaticResource FluentNavButton}"
                                         GroupName="SidebarNav"
                                         Tag="4"
                                         IsChecked="{Binding IsHotkeysPageSelected, Mode=OneWay}"
                                         Checked="NavButton_Checked" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Column 1: Main Content Pane -->
            <TabControl x:Name="ContentTabControl"
                        Grid.Column="1"
                        Background="{StaticResource MutedCharcoalBg}"
                        BorderThickness="0"
                        Padding="0"
                        SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                        SelectionChanged="ContentTabControl_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Page 0: Direct Selected Preset Editor (2D Topology + Ranked Audio + Mic + App Hooks) -->
                <TabItem Header="🖥️ Preset">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,10">
                        <ContentControl Content="{Binding SelectedPreset}"
                                        ContentTemplate="{StaticResource PresetDetailTemplate}" />
                    </ScrollViewer>
                </TabItem>

                <!-- Page 1: Alias to Selected Preset Editor for CLI / Screenshot Backward Compatibility -->
                <TabItem Header="📺 Displays &amp; Topology">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,10">
                        <ContentControl Content="{Binding SelectedPreset}"
                                        ContentTemplate="{StaticResource PresetDetailTemplate}" />
                    </ScrollViewer>
                </TabItem>

                <!-- Page 2: Audio & DAC Lockout -->
                <TabItem Header="🔊 Audio &amp; DAC Lockout">
                    <Grid Margin="22,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Master Setting Card: Audio Visibility & Lockout Description -->
                        <Border Grid.Row="0" Style="{StaticResource FluentSettingCard}" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Audio Menu Visibility &amp; Bass Shaker / DAC Lockout" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Use the left switch to hide unused endpoints from Windows menus. Use the right 'Exclude / Bass Shaker DAC' switch to lock out dedicated telemetry transducers (e.g. Buttkicker / SimHub DACs) so RigSwitch never routes system audio to them."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Search and Filter Controls -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Box with Clean Watermark -->
                            <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBox x:Name="AudioSearchTextBox"
                                         Text="{Binding AudioSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FluentTextBox}"
                                         Padding="10,7"
                                         ToolTip="Search audio devices by name or adapter" />
                                <TextBlock Text="🔍 Search audio endpoints..."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=AudioSearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Status Filter Segmented Control -->
                            <Border Grid.Column="1"
                                    Background="#141517"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="3"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Relevant Devices"
                                            Command="{Binding SelectRelevantAudioFilterCommand}"
                                            Style="{StaticResource FluentFilterRelevantButton}"
                                            Margin="0,0,4,0"
                                            ToolTip="Show active, disabled, unplugged, and preset-referenced devices (hides stale registry ghosts)" />
                                    <Button Content="Active Only"
                                            Command="{Binding SelectActiveAudioFilterCommand}"
                                            Style="{StaticResource FluentFilterActiveButton}"
                                            Margin="0,0,4,0" />
                                    <Button Content="Disabled / Unplugged"
                                            Command="{Binding SelectInactiveAudioFilterCommand}"
                                            Style="{StaticResource FluentFilterInactiveButton}"
                                            Margin="0,0,4,0" />
                                    <Button Content="All Registry Ghosts"
                                            Command="{Binding SelectAllAudioFilterCommand}"
                                            Style="{StaticResource FluentFilterRegistryGhostsButton}"
                                            ToolTip="Show every historical endpoint stored in the Windows registry" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Filter Mode Summary & Count Indicator -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding FilterStatusSummary}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="2,0,0,10" />

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredAudioEndpoints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource GraphiteCardBg}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,11"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          Style="{StaticResource FluentToggleSwitch}"
                                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,14,0"
                                                          ToolTip="Toggle endpoint visibility in Windows audio menus" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Adapter}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Id}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Opacity="0.65" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Blacklist / Bass Shaker Exclusion Toggle -->
                                                <CheckBox Grid.Column="2"
                                                          Style="{StaticResource FluentToggleSwitchRig}"
                                                          Content="Exclude / Bass Shaker DAC"
                                                          IsChecked="{Binding IsBlacklisted, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          FontSize="12.5"
                                                          Margin="0,0,16,0"
                                                          ToolTip="Exclude this audio endpoint from profile routing (e.g. Bass Shaker / Buttkicker DAC)." />

                                                <!-- Presence State Badge -->
                                                <Border Grid.Column="3"
                                                        Background="{Binding StateBadgeBackground}"
                                                        BorderBrush="{Binding StateBadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateLabel}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding StateBadgeForeground}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Page 3: Device Nicknames -->
                <TabItem Header="🏷️ Device Nicknames">
                    <Grid Margin="22,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Card -->
                        <Border Grid.Row="0" Style="{StaticResource FluentSettingCard}" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Hardware Device Nicknames" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Assign custom friendly names to specific monitors, speakers, headsets, or microphones. Only devices you've nicknamed are listed below — no clutter from unconfigured hardware."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- + Add New Device Nickname Card -->
                        <Border Grid.Row="1" Style="{StaticResource FluentSettingCard}" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="＋ Assign New Device Nickname" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource AccentDesk}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding UnnicknamedDeviceOptions}"
                                              SelectedValue="{Binding SelectedNewNicknameDeviceId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="DisplayName"
                                              VerticalAlignment="Center" />

                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="NewNicknameTextBox"
                                                 Text="{Binding NewNicknameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FluentTextBox}"
                                                 Padding="10,7" />
                                        <TextBlock Text="Enter friendly nickname (e.g. Sim Rig Ultrawide)..."
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NewNicknameTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Button Grid.Column="4"
                                            Content="＋ Add Nickname"
                                            Command="{Binding AddNicknameCommand}"
                                            Style="{StaticResource FluentActionButton}"
                                            Background="{StaticResource AccentDesk}"
                                            Foreground="#141517"
                                            Padding="16,8"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Text="CONFIGURED DEVICE NICKNAMES"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="2,0,0,8" />

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ConfiguredNicknames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DeviceNicknameItemViewModel}">
                                        <Border Background="{StaticResource GraphiteCardBg}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,11"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="340" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#1C1D1F" BorderBrush="{StaticResource AccentDesk}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding DeviceType}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentDesk}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding HardwareName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DeviceId}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding CustomNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource FluentTextBox}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"
                                                         ToolTip="Edit custom friendly nickname" />
                                                <Button Grid.Column="2"
                                                        Content="✕ Remove"
                                                        Command="{Binding RemoveCommand}"
                                                        Style="{StaticResource FluentButton}"
                                                        Padding="10,6"
                                                        FontSize="12"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Remove custom nickname" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Page 4: Hotkeys & System -->
                <TabItem Header="⌨️ Hotkeys &amp; System">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,14">
                        <StackPanel>
                            <!-- Global Hotkeys Card -->
                            <Border Style="{StaticResource FluentSettingCard}" Padding="18,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Global Keyboard Shortcuts" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource AccentRig}" Margin="0,0,0,2" />
                                    <TextBlock Text="Configure global hotkeys to switch workstation profiles or cycle ranked audio output destinations from within games and full-screen apps." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Toggle Desk / Sim Rig:" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding ToggleHotkey, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Direct Desk Activation:" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding DeskHotkey, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Direct Sim Rig Activation:" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding RigHotkey, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cycle Ranked Audio (#1 → #N):" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding AudioToggleHotkey, Mode=TwoWay}" Watermark="None (Optional)" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CoreAudio Watchdog Card -->
                            <Border Style="{StaticResource FluentSettingCard}" Padding="18,13" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="CoreAudio Watchdog &amp; Ranked Audio Enforcement" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Event-driven CoreAudio session monitor that automatically re-asserts your highest-ranked online audio device if background software (e.g. SteelSeries Sonar or VR drivers) hijacks output." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource FluentToggleSwitch}"
                                              IsChecked="{Binding EnforcePrimaryAudio, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Application Preferences Card -->
                            <Border Style="{StaticResource FluentSettingCard}" Padding="18,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Application Preferences" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="Configure startup, background notification, and maintenance behaviors." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                                    <!-- Start Minimized -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Start Minimized to System Tray" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Launch RigSwitch quietly in the Windows notification area on boot." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource FluentToggleSwitch}"
                                                  IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Toast Notifications -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Profile Switch Toast Notifications" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Display Windows balloon and toast notifications when workstation profile changes." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource FluentToggleSwitch}"
                                                  IsChecked="{Binding ShowToastNotifications, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Auto Update Check -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Automatic Startup Update Checks" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Check GitHub Releases and WinGet for new RigSwitch versions on launch." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource FluentToggleSwitch}"
                                                  IsChecked="{Binding EnableAutoUpdateCheck, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Software Updates Card -->
                            <Border Style="{StaticResource FluentSettingCard}" Padding="18,13" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Software Updates &amp; Releases" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Check GitHub Releases and WinGet for new RigSwitch versions and patches." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="🚀 Check for Updates"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            Style="{StaticResource FluentButton}"
                                            Padding="16,8"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Bottom Status & Action Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource HeaderFooterBg}"
                BorderBrush="{StaticResource HeaderFooterBorder}"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="13.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Content="💾 Save Settings"
                        Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource FluentActionButton}"
                        Background="{StaticResource AccentDesk}"
                        Foreground="#141517"
                        FontWeight="Bold"
                        FontSize="13.5"
                        Padding="22,8" />
            </Grid>
        </Border>
    </Grid>
</Window>
