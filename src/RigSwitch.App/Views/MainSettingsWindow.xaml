<Window x:Class="RigSwitch.App.Views.MainSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RigSwitch.App.ViewModels"
        xmlns:ctrl="clr-namespace:RigSwitch.App.Controls"
        xmlns:enums="clr-namespace:RigSwitch.Core.Enums;assembly=RigSwitch.Core"
        mc:Ignorable="d"
        Title="RigSwitch — Workstation &amp; Sim Rig Hardware Controller"
        Width="960"
        Height="700"
        MinWidth="860"
        MinHeight="580"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MutedCharcoalBg}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        d:DataContext="{d:DesignInstance Type=vm:MainSettingsViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Palette Aliases for Warm Charcoal Theme -->
        <SolidColorBrush x:Key="OledBaseBg" Color="#1C1D1F" />
        <SolidColorBrush x:Key="OledControlBg" Color="#26272B" />
        <SolidColorBrush x:Key="OledBorder" Color="#2A2B2F" />
        <SolidColorBrush x:Key="OledBorderBright" Color="#33353D" />

        <SolidColorBrush x:Key="TextPrimary" Color="#E2E4E8" />
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B" />

        <!-- Base Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource FluentTextBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}" />

        <Style TargetType="CheckBox" BasedOn="{StaticResource FluentToggleSwitch}" />

        <Style TargetType="Button" BasedOn="{StaticResource FluentButton}" />

        <Style x:Key="AccentSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentActionButton}">
            <Setter Property="Background" Value="{StaticResource AccentDesk}" />
            <Setter Property="Foreground" Value="#141517" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="22,8" />
        </Style>

        <!-- Monitor Tile Template for Drag-and-Drop / Pile Management -->
        <DataTemplate x:Key="MonitorTileTemplate" DataType="{x:Type vm:DisplayMonitorTileViewModel}">
            <Border x:Name="TileBorder"
                    Background="{StaticResource GraphiteCardBg}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,12,12"
                    Width="175">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Tile Header Badge -->
                    <Border x:Name="HeaderBadge"
                            Grid.Row="0"
                            Background="#182A22"
                            BorderBrush="{StaticResource AccentDesk}"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8">
                        <TextBlock x:Name="HeaderText"
                                   Text="{Binding DisplayNumber, StringFormat='Monitor {0}'}"
                                   FontWeight="ExtraBold"
                                   FontSize="15"
                                   Foreground="{StaticResource AccentDesk}" />
                    </Border>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="{Binding FriendlyName}"
                                   FontWeight="Bold"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="150" />
                        <TextBlock Text="{Binding MonitorId}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="150"
                                   Margin="0,2,0,0" />
                        <TextBlock x:Name="OfflineStatusText"
                                   Text="Offline / Disconnected"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#F87171"
                                   TextAlignment="Center"
                                   Visibility="Collapsed"
                                   Margin="0,2,0,0" />
                        <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="6,1.5" Margin="0,4,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding HasHdrBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding HdrBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                    </StackPanel>

                    <!-- Desk / Sim Rig Radio Pills -->
                    <Border Grid.Row="2" Background="#1C1D1F" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" CornerRadius="8" Padding="2">
                        <UniformGrid Columns="3">
                            <Button Content="Off"
                                    Command="{Binding MoveToUnassignedCommand}"
                                    Padding="4,5"
                                    FontSize="11"
                                    Margin="1"
                                    ToolTip="Remove from Desk/Rig profiles">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FluentButton}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnassigned}" Value="True">
                                                <Setter Property="Background" Value="#383A42" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Desk"
                                    Command="{Binding MoveToDeskCommand}"
                                    Padding="4,5"
                                    FontSize="11"
                                    Margin="1"
                                    ToolTip="Assign to Desk Profile">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FluentButton}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDesk}" Value="True">
                                                <Setter Property="Background" Value="#182A22" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentDesk}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Rig"
                                    Command="{Binding MoveToRigCommand}"
                                    Padding="4,5"
                                    FontSize="11"
                                    Margin="1"
                                    ToolTip="Assign to Sim Rig Profile">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FluentButton}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRig}" Value="True">
                                                <Setter Property="Background" Value="#2D2316" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentRig}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="TileBorder" Property="Opacity" Value="0.65" />
                    <Setter TargetName="HeaderBadge" Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                    <Setter TargetName="HeaderText" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                    <Setter TargetName="OfflineStatusText" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Sleek Rounded Pill Tab Styles for Desk Presets (Soft Sage #10B981) -->
        <Style x:Key="DeskSubTabItemStyle" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#26272B"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16,6"
                                Margin="0,0,8,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#182A22" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentDesk}" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1.5" />
                                <Setter Property="Foreground" Value="{StaticResource AccentDesk}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#2E3036" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#5A5D68" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Rounded Pill Tab Styles for Sim Rig Presets (Warm Amber #F59E0B) -->
        <Style x:Key="RigSubTabItemStyle" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#26272B"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16,6"
                                Margin="0,0,8,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2D2316" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentRig}" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1.5" />
                                <Setter Property="Foreground" Value="{StaticResource AccentRig}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#2E3036" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#5A5D68" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeskSubTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DeskSubTabItemStyle}" />
        </Style>

        <Style x:Key="RigSubTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RigSubTabItemStyle}" />
        </Style>

        <Style x:Key="SubTabControlStyle" TargetType="TabControl" BasedOn="{StaticResource DeskSubTabControlStyle}" />

        <!-- Preset Header & Detail Templates -->
        <DataTemplate x:Key="PresetHeaderTemplate" DataType="{x:Type vm:PresetConfigurationItemViewModel}">
            <TextBlock Text="{Binding Header}" FontSize="13" />
        </DataTemplate>

        <DataTemplate x:Key="PresetDetailTemplate" DataType="{x:Type vm:PresetConfigurationItemViewModel}">
            <StackPanel Margin="0,12,0,4">
                <!-- Setting Card: Preset Identity & Default Activation -->
                <Border Style="{StaticResource FluentSettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Preset Identity &amp; Default Activation" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Assign a friendly preset label and designate this configuration as the default active profile." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <RadioButton Content="Default Active"
                                         IsChecked="{Binding IsActive, Mode=TwoWay}"
                                         GroupName="{Binding GroupName}"
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Setting Card: Target Display & Windows HDR -->
                <Border Style="{StaticResource FluentSettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Target Display &amp; Windows HDR" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Designate the target display and choose whether Windows HDR (Advanced Color) is retained, enabled, or disabled." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="300">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding DataContext.AvailableDisplayOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValue="{Binding TargetMonitorId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="🖥️ Display Settings"
                                        Command="{Binding OpenDisplaySettingsCommand}"
                                        Padding="10,6"
                                        FontSize="12" />
                            </Grid>
                            <ComboBox SelectedValue="{Binding HdrMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Retain Current Windows HDR State" Tag="{x:Static enums:PresetHdrMode.Retain}" />
                                <ComboBoxItem Content="Enable HDR (Advanced Color)" Tag="{x:Static enums:PresetHdrMode.Enable}" />
                                <ComboBoxItem Content="Disable HDR (SDR Standard)" Tag="{x:Static enums:PresetHdrMode.Disable}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Setting Card: Primary Audio Endpoint -->
                <Border Style="{StaticResource FluentSettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Primary Audio Endpoint" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Default sound playback device for desktop speakers, soundbar, or direct DAC output." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Width="300"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding DataContext.AvailableAudioOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedValue="{Binding PrimaryAudioId, Mode=TwoWay}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="DisplayName" />
                    </Grid>
                </Border>

                <!-- Setting Card: Secondary Audio (Headset / Sonar) -->
                <Border Style="{StaticResource FluentSettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Secondary Audio (Headset / Sonar)" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Secondary playback destination for wireless headsets, VR audio, or gaming communications." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Width="300"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding DataContext.AvailableAudioOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedValue="{Binding SecondaryAudioId, Mode=TwoWay}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="DisplayName" />
                    </Grid>
                </Border>

                <!-- Setting Card: Fallback Audio Endpoint -->
                <Border Style="{StaticResource FluentSettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Fallback Audio Endpoint" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Backup playback device automatically activated if the primary audio device is unplugged or offline." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Width="300"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding DataContext.AvailableAudioOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedValue="{Binding FallbackAudioId, Mode=TwoWay}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="DisplayName" />
                    </Grid>
                </Border>

                <!-- Setting Card: Playback Volume & Mute -->
                <Border Style="{StaticResource FluentSettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Playback Volume &amp; Mute" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Configure default volume behavior, set a fixed level, or toggle output mute upon profile switch." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="300">
                            <ComboBox SelectedValue="{Binding PlaybackVolumeMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="Retain System Volume" Tag="{x:Static enums:PresetVolumeBehavior.Retain}" />
                                <ComboBoxItem Content="Custom Volume Level" Tag="{x:Static enums:PresetVolumeBehavior.Custom}" />
                            </ComboBox>
                            <Grid Visibility="{Binding IsCustomPlaybackVolume, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Value="{Binding PlaybackVolumePercent, Mode=TwoWay}"
                                        Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                        VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Border Grid.Column="1" Background="#1C1D1F" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlaybackVolumePercent, StringFormat='{}{0}%'}"
                                               FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="34" TextAlignment="Center" />
                                </Border>
                                <CheckBox Grid.Column="2"
                                          Content="Mute"
                                          Style="{StaticResource FluentToggleSwitch}"
                                          IsChecked="{Binding PlaybackVolumeIsMuted, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Setting Card: Microphones & Input Levels -->
                <Border Style="{StaticResource FluentSettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Microphones &amp; Input Levels" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Assign primary, secondary, and fallback voice input devices, and configure capture levels." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="300">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Primary:" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DataContext.AvailableMicrophoneOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValue="{Binding PrimaryMicrophoneId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Secondary:" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DataContext.AvailableMicrophoneOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValue="{Binding SecondaryMicrophoneId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fallback:" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DataContext.AvailableMicrophoneOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValue="{Binding FallbackMicrophoneId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="DisplayName" />
                            </Grid>
                            <ComboBox SelectedValue="{Binding MicrophoneVolumeMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      Margin="0,2,0,6">
                                <ComboBoxItem Content="Retain System Volume" Tag="{x:Static enums:PresetVolumeBehavior.Retain}" />
                                <ComboBoxItem Content="Custom Input Level" Tag="{x:Static enums:PresetVolumeBehavior.Custom}" />
                            </ComboBox>
                            <Grid Visibility="{Binding IsCustomMicrophoneVolume, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Value="{Binding MicrophoneVolumePercent, Mode=TwoWay}"
                                        Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                        VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Border Grid.Column="1" Background="#1C1D1F" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MicrophoneVolumePercent, StringFormat='{}{0}%'}"
                                               FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="34" TextAlignment="Center" />
                                </Border>
                                <CheckBox Grid.Column="2"
                                          Content="Mute"
                                          Style="{StaticResource FluentToggleSwitch}"
                                          IsChecked="{Binding MicrophoneVolumeIsMuted, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Setting Card: Direct Hotkey -->
                <Border Style="{StaticResource FluentSettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Direct Hotkey" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Global keyboard shortcut to instantly activate this specific workstation preset." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ctrl:HotkeyRecorderControl Grid.Column="1"
                                                    Hotkey="{Binding DirectHotkey, Mode=TwoWay}"
                                                    Watermark="None (Optional)"
                                                    Width="330"
                                                    VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Setting Card: Lifecycle Application Hooks -->
                <Border Style="{StaticResource FluentSettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Lifecycle Application Hooks" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Launch software and utilities when activating this preset, and terminate them when switching away." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ Add Application (.exe)"
                                    Command="{Binding AddApplicationHookCommand}"
                                    Style="{StaticResource FluentButton}"
                                    Padding="12,6"
                                    FontSize="12.5"
                                    VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ApplicationHooks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ApplicationHookItemViewModel}">
                                    <Border Background="#202125" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Content="Close on switch away"
                                                      Style="{StaticResource FluentToggleSwitch}"
                                                      IsChecked="{Binding CloseOnSwitchAway, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="14,0,14,0" />
                                            <Button Grid.Column="2"
                                                    Content="✕"
                                                    Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource FluentButton}"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Remove application hook" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderFooterBg}"
                BorderBrush="{StaticResource HeaderFooterBorder}"
                BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ RigSwitch"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center" />
                    <!-- Profile Badge Pill: Soft Sage border/text when Desk, Warm Amber Gold when Rig -->
                    <Border CornerRadius="12"
                            BorderThickness="1.5"
                            Padding="12,4"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#182A22" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentDesk}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRigActive}" Value="True">
                                        <Setter Property="Background" Value="#2D2316" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentRig}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CurrentProfileBadgeText}"
                                   FontSize="13"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AccentDesk}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRigActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentRig}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Quick Station Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🖥️ Desk Setup"
                            Command="{Binding SwitchToDeskCommand}"
                            Style="{StaticResource FluentButton}"
                            BorderBrush="{StaticResource AccentDesk}"
                            Margin="0,0,10,0"
                            Padding="14,7"
                            FontSize="13" />
                    <Button Content="🏎️ Sim Rig"
                            Command="{Binding SwitchToRigCommand}"
                            Style="{StaticResource FluentButton}"
                            BorderBrush="{StaticResource AccentRig}"
                            Padding="14,7"
                            FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Navigation Body: 2-Column Sidebar Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Navigation Sidebar Rail -->
            <Border Grid.Column="0"
                    Background="{StaticResource SlateSidebarBg}"
                    BorderBrush="{StaticResource HeaderFooterBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="14,16,14,14">
                <DockPanel LastChildFill="True">
                    <!-- Bottom: CoreAudio Watchdog Status Card -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource GraphiteCardBg}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentDesk}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="CoreAudio Watchdog" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Real-time session monitoring active" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Top: Navigation Rail Items -->
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavPresets"
                                     Content="🖥️ Presets"
                                     Style="{StaticResource FluentNavButton}"
                                     GroupName="SidebarNav"
                                     Tag="0"
                                     IsChecked="True"
                                     Checked="NavButton_Checked" />
                        <RadioButton x:Name="NavDisplays"
                                     Content="📺 Displays &amp; Topology"
                                     Style="{StaticResource FluentNavButton}"
                                     GroupName="SidebarNav"
                                     Tag="1"
                                     Checked="NavButton_Checked" />
                        <RadioButton x:Name="NavAudio"
                                     Content="🔊 Audio &amp; DAC Lockout"
                                     Style="{StaticResource FluentNavButton}"
                                     GroupName="SidebarNav"
                                     Tag="2"
                                     Checked="NavButton_Checked" />
                        <RadioButton x:Name="NavNicknames"
                                     Content="🏷️ Device Nicknames"
                                     Style="{StaticResource FluentNavButton}"
                                     GroupName="SidebarNav"
                                     Tag="3"
                                     Checked="NavButton_Checked" />
                        <RadioButton x:Name="NavHotkeys"
                                     Content="⌨️ Hotkeys &amp; System"
                                     Style="{StaticResource FluentNavButton}"
                                     GroupName="SidebarNav"
                                     Tag="4"
                                     Checked="NavButton_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Column 1: Main Content Pane -->
            <TabControl x:Name="ContentTabControl"
                        Grid.Column="1"
                        Background="{StaticResource MutedCharcoalBg}"
                        BorderThickness="0"
                        Padding="0"
                        SelectionChanged="ContentTabControl_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavPresets}" Value="True">
                                <Setter Property="SelectedIndex" Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavDisplays}" Value="True">
                                <Setter Property="SelectedIndex" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavAudio}" Value="True">
                                <Setter Property="SelectedIndex" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavNicknames}" Value="True">
                                <Setter Property="SelectedIndex" Value="3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NavHotkeys}" Value="True">
                                <Setter Property="SelectedIndex" Value="4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>

                <!-- Page 0: Presets -->
                <TabItem Header="🖥️ Presets">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                        <StackPanel>
                            <!-- Desk Presets Section -->
                            <StackPanel Margin="0,0,0,24">
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🖥️ Desk Presets" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentDesk}" />
                                            <TextBlock Text=" — Productivity &amp; Media" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="Workstation configurations optimized for coding, design, and multi-monitor productivity." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TabControl ItemsSource="{Binding DeskPresets}"
                                            Style="{StaticResource DeskSubTabControlStyle}"
                                            ItemTemplate="{StaticResource PresetHeaderTemplate}"
                                            ContentTemplate="{StaticResource PresetDetailTemplate}" />
                            </StackPanel>

                            <!-- Sim Rig Presets Section -->
                            <StackPanel Margin="0,0,0,12">
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏎️ Sim Rig Presets" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentRig}" />
                                            <TextBlock Text=" — GT3, Rally &amp; Cockpit" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="Specialized configurations for racing wheels, flight sticks, haptic transducers, and VR headsets." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TabControl ItemsSource="{Binding RigPresets}"
                                            Style="{StaticResource RigSubTabControlStyle}"
                                            ItemTemplate="{StaticResource PresetHeaderTemplate}"
                                            ContentTemplate="{StaticResource PresetDetailTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Page 1: Displays & Topology -->
                <TabItem Header="📺 Displays &amp; Topology">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                        <StackPanel>
                            <!-- Multi-Monitor Topology Card -->
                            <Border Style="{StaticResource FluentSettingCard}" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Multi-Monitor Topology Configuration" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Assign connected monitors by number to Desk or Sim Rig piles (supports single, dual, or 3-screen sim rigs)." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="🔍 Identify Monitors"
                                                Command="{Binding IdentifyMonitorsCommand}"
                                                Padding="14,7"
                                                Style="{StaticResource FluentButton}"
                                                BorderBrush="{StaticResource AccentDesk}"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding MonitorTiles}"
                                                  ItemTemplate="{StaticResource MonitorTileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Hardware Telemetry Summary Card -->
                            <Border Style="{StaticResource FluentSettingCard}" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Hardware Telemetry Summary" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Real-time enumeration of connected displays and active CoreAudio output endpoints." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="↻ Refresh Hardware"
                                                Command="{Binding RefreshDevicesCommand}"
                                                Style="{StaticResource FluentButton}"
                                                Padding="12,6"
                                                FontSize="12.5"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Active Displays:" FontWeight="SemiBold" Margin="0,6,0,4" Foreground="{StaticResource TextMutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding DetectedDisplays}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FriendlyName, StringFormat='• {0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Active Audio Endpoints:" FontWeight="SemiBold" Margin="0,10,0,4" Foreground="{StaticResource TextMutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding DetectedAudioEndpoints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, StringFormat='• {0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Page 2: Audio & DAC Lockout -->
                <TabItem Header="🔊 Audio &amp; DAC Lockout">
                    <Grid Margin="24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Master Setting Card: Audio Visibility & Lockout Description -->
                        <Border Grid.Row="0" Style="{StaticResource FluentSettingCard}" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Disable Non-Preset Audio Devices &amp; Virtual Endpoints" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Clean up Windows audio menus by toggling virtual playback endpoints. Devices marked as excluded (e.g. Bass Shakers or Tactile Transducer DACs) remain active in Windows for telemetry, but are barred from default audio routing."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="13.5"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Search and Filter Controls -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Box with Clean Watermark -->
                            <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBox x:Name="AudioSearchTextBox"
                                         Text="{Binding AudioSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FluentTextBox}"
                                         Padding="10,7"
                                         ToolTip="Search audio devices by name or adapter" />
                                <TextBlock Text="🔍 Search audio endpoints..."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=AudioSearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Status Filter Segmented Control -->
                            <Border Grid.Column="1"
                                    Background="#141517"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="3"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="All Devices"
                                                 GroupName="AudioStatusFilterGroup"
                                                 IsChecked="{Binding IsAllFilterSelected, Mode=TwoWay}"
                                                 Command="{Binding SelectAllAudioFilterCommand}"
                                                 Style="{StaticResource FluentFilterSegment}"
                                                 Margin="0,0,2,0" />
                                    <RadioButton Content="Active Only"
                                                 GroupName="AudioStatusFilterGroup"
                                                 IsChecked="{Binding IsActiveFilterSelected, Mode=TwoWay}"
                                                 Command="{Binding SelectActiveAudioFilterCommand}"
                                                 Style="{StaticResource FluentFilterSegmentActive}"
                                                 Margin="0,0,2,0" />
                                    <RadioButton Content="Disabled / Unplugged"
                                                 GroupName="AudioStatusFilterGroup"
                                                 IsChecked="{Binding IsInactiveFilterSelected, Mode=TwoWay}"
                                                 Command="{Binding SelectInactiveAudioFilterCommand}"
                                                 Style="{StaticResource FluentFilterSegmentInactive}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Filter Mode Summary & Count Indicator -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding FilterStatusSummary}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="2,0,0,10" />

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredAudioEndpoints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource GraphiteCardBg}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          Style="{StaticResource FluentToggleSwitch}"
                                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,14,0"
                                                          ToolTip="Toggle endpoint visibility in Windows audio menus" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Adapter}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Id}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Opacity="0.65" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Blacklist / Bass Shaker Exclusion Toggle -->
                                                <CheckBox Grid.Column="2"
                                                          Style="{StaticResource FluentToggleSwitchRig}"
                                                          Content="Exclude / Bass Shaker DAC"
                                                          IsChecked="{Binding IsBlacklisted, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          FontSize="12.5"
                                                          Margin="0,0,16,0"
                                                          ToolTip="Exclude this audio endpoint from profile routing (e.g. Bass Shaker / Buttkicker DAC)." />

                                                <!-- Presence State Badge -->
                                                <Border Grid.Column="3"
                                                        Background="{Binding StateBadgeBackground}"
                                                        BorderBrush="{Binding StateBadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateLabel}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding StateBadgeForeground}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Page 3: Device Nicknames -->
                <TabItem Header="🏷️ Device Nicknames">
                    <Grid Margin="24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Card -->
                        <Border Grid.Row="0" Style="{StaticResource FluentSettingCard}" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Hardware Device Nicknames" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Map detected monitors, microphones, and audio playback devices to clean friendly names. These friendly nicknames override cryptic Windows hardware identifiers throughout RigSwitch."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="13.5"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DeviceNicknames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource GraphiteCardBg}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="280" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#1C1D1F" BorderBrush="{StaticResource AccentDesk}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding DeviceType}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentDesk}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding HardwareName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DeviceId}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding CustomNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource FluentTextBox}"
                                                         VerticalAlignment="Center"
                                                         ToolTip="Enter custom friendly nickname" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Page 4: Hotkeys & System -->
                <TabItem Header="⌨️ Hotkeys &amp; System">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                        <StackPanel>
                            <!-- Global Hotkeys Card -->
                            <Border Style="{StaticResource FluentSettingCard}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Global Keyboard Shortcuts" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentRig}" Margin="0,0,0,4" />
                                    <TextBlock Text="Configure global hotkeys to switch workstation profiles or toggle audio output destinations from within games and full-screen apps." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Toggle Desk / Sim Rig:" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding ToggleHotkey, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Direct Desk Activation:" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding DeskHotkey, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Direct Sim Rig Activation:" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding RigHotkey, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Toggle Audio (Speakers / Headset):" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" />
                                        <ctrl:HotkeyRecorderControl Grid.Column="1" Hotkey="{Binding AudioToggleHotkey, Mode=TwoWay}" Watermark="None (Optional)" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CoreAudio Watchdog Card -->
                            <Border Style="{StaticResource FluentSettingCard}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="CoreAudio Watchdog &amp; Speaker Enforcement" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Actively monitor Windows audio session routing and automatically re-assert primary speakers if background software (e.g. SteelSeries Sonar) hijacks output." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource FluentToggleSwitch}"
                                              IsChecked="{Binding EnforcePrimaryAudio, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Application Preferences Card -->
                            <Border Style="{StaticResource FluentSettingCard}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Application Preferences" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Configure startup, background notification, and maintenance behaviors." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                                    <!-- Start Minimized -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Start Minimized to System Tray" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Launch RigSwitch quietly in the Windows notification area on boot." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource FluentToggleSwitch}"
                                                  IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Toast Notifications -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Profile Switch Toast Notifications" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Display Windows balloon and toast notifications when workstation profile changes." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource FluentToggleSwitch}"
                                                  IsChecked="{Binding ShowToastNotifications, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Auto Update Check -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Automatic Startup Update Checks" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Check GitHub Releases and WinGet for new RigSwitch versions on launch." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource FluentToggleSwitch}"
                                                  IsChecked="{Binding EnableAutoUpdateCheck, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Software Updates Card -->
                            <Border Style="{StaticResource FluentSettingCard}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Software Updates &amp; Releases" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Check GitHub Releases and WinGet for new RigSwitch versions and patches." FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="🚀 Check for Updates"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            Style="{StaticResource FluentButton}"
                                            Padding="16,8"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Bottom Status & Action Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource HeaderFooterBg}"
                BorderBrush="{StaticResource HeaderFooterBorder}"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="13.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Content="💾 Save Settings"
                        Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource FluentActionButton}"
                        Background="{StaticResource AccentDesk}"
                        Foreground="#141517"
                        FontWeight="Bold"
                        FontSize="13.5"
                        Padding="22,8" />
            </Grid>
        </Border>
    </Grid>
</Window>
