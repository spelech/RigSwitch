<Window x:Class="RigSwitch.App.Views.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RigSwitch — Update Available"
        Width="580"
        Height="420"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="OledBorder" Color="#262634" />
        <SolidColorBrush x:Key="OledBorderBright" Color="#3A3A4E" />
        <SolidColorBrush x:Key="AccentGreen" Color="#00C853" />
        <SolidColorBrush x:Key="AccentOrange" Color="#FF5500" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextMuted" Color="#8E95A5" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#101016" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource OledBorderBright}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryDownloadButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#00C853" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#000000" BorderBrush="{StaticResource AccentGreen}" BorderThickness="3,1,1,1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🚀 NEW RELEASE AVAILABLE" FontSize="16" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Bahnschrift" Foreground="{StaticResource AccentGreen}" />
                </StackPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VersionText" Text="Installed: v1.0.0 ➔ Latest: v1.1.0" FontSize="13" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="GitHub / WinGet Release" FontSize="12" Foreground="{StaticResource TextMuted}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Release Notes Area -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Release Notes:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
            <Border Grid.Row="1" Background="#050508" BorderBrush="{StaticResource OledBorderBright}" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="ReleaseNotesTextBox"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource TextPrimary}"
                             TextWrapping="Wrap"
                             FontSize="12"
                             FontFamily="Consolas, Segoe UI, sans-serif" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="DelayButton" Content="⏰ Delay 1 Day" Click="OnDelayClick" Margin="0,0,8,0" ToolTip="Delay update prompt for 24 hours" />
                <Button x:Name="IgnoreButton" Content="🚫 Ignore This Version" Click="OnIgnoreClick" ToolTip="Skip notifications for this specific release" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="Close" Click="OnCloseClick" Margin="0,0,8,0" />
                <Button x:Name="DownloadButton" Content="📥 Download Update" Style="{StaticResource PrimaryDownloadButtonStyle}" Click="OnDownloadClick" ToolTip="Open download page in default browser" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
